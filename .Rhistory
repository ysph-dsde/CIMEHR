GIVEHR = function(dat) {
fit <- GIVEHR(data = dat)
beta <- fit$longitudinal_outcome$beta_Y
se   <- fit$longitudinal_outcome$se_beta_naive
z    <- qnorm(0.975)
list(
beta    = beta,
se      = se,
ci_low  = beta - z * se,
ci_high = beta + z * se,
extra   = list(gamma = fit$visiting_process$gamma_V,
sigma2_zeta = fit$visiting_process$sigma2_zeta)
)
}
)
METHOD_NAMES <- names(methods)
# ============================================================================
# 2. Single-replication worker
# ============================================================================
run_one_rep <- function(sim_id) {
# Generate data
suppressMessages(
sim <- sim_data_gen(n = N_SUBJ, seed = sim_id)
)
dat   <- sim$long_data
dat$C <- sim$params$time.end
# Run all methods; catch failures per method
rep_results <- list()
for (m in METHOD_NAMES) {
rep_results[[m]] <- tryCatch(
methods[[m]](dat),
error = function(e) {
list(beta = NULL, se = NULL, ci_low = NULL, ci_high = NULL,
error = conditionMessage(e))
}
)
}
list(sim_id = sim_id, results = rep_results)
}
# ============================================================================
# 3. Run all replications
# ============================================================================
cat("Starting simulations ...\n")
t0 <- Sys.time()
if (N_CORES > 1 && requireNamespace("parallel", quietly = TRUE)) {
cat(sprintf("  Using %d cores (parallel::mclapply)\n", N_CORES))
all_reps <- parallel::mclapply(
seq_len(N_SIM), run_one_rep,
mc.cores = N_CORES, mc.set.seed = TRUE
)
} else {
all_reps <- vector("list", N_SIM)
for (i in seq_len(N_SIM)) {
if (i %% 50 == 0) cat(sprintf("  Replication %d / %d\n", i, N_SIM))
all_reps[[i]] <- run_one_rep(i)
}
}
elapsed <- as.numeric(difftime(Sys.time(), t0, units = "mins"))
cat(sprintf("Done in %.1f minutes.\n\n", elapsed))
# ============================================================================
# 4. Assemble results into a tidy data.frame
# ============================================================================
rows <- list()
for (rep in all_reps) {
for (m in METHOD_NAMES) {
res <- rep$results[[m]]
if (is.null(res$beta)) {
# Method failed — record NA row
for (p in PARAM_NAMES) {
rows[[length(rows) + 1]] <- data.frame(
sim_id  = rep$sim_id,
method  = m,
param   = p,
est     = NA_real_,
se      = NA_real_,
ci_low  = NA_real_,
ci_high = NA_real_,
failed  = TRUE,
stringsAsFactors = FALSE
)
}
} else {
for (p in PARAM_NAMES) {
rows[[length(rows) + 1]] <- data.frame(
sim_id  = rep$sim_id,
method  = m,
param   = p,
est     = if (p %in% names(res$beta)) res$beta[p] else NA_real_,
se      = if (!is.null(res$se) && p %in% names(res$se)) res$se[p] else NA_real_,
ci_low  = if (!is.null(res$ci_low) && p %in% names(res$ci_low)) res$ci_low[p] else NA_real_,
ci_high = if (!is.null(res$ci_high) && p %in% names(res$ci_high)) res$ci_high[p] else NA_real_,
failed  = FALSE,
stringsAsFactors = FALSE
)
}
}
}
}
sim_df <- do.call(rbind, rows)
rownames(sim_df) <- NULL
# Add true values
sim_df$true_value <- TRUE_BETA[sim_df$param]
# ============================================================================
# 5. Compute performance metrics
# ============================================================================
compute_metrics <- function(df) {
# df is a subset for one method x param combination
df <- df[!df$failed & !is.na(df$est), ]
n_ok   <- nrow(df)
n_fail <- sum(df$failed, na.rm = TRUE)
if (n_ok == 0) {
return(data.frame(
n_reps = 0, n_fail = n_fail,
bias = NA, emp_se = NA, mean_se = NA,
se_ratio = NA, rmse = NA, coverage = NA
))
}
true <- df$true_value[1]
bias  <- mean(df$est) - true
emp_se <- sd(df$est)
rmse   <- sqrt(mean((df$est - true)^2))
# SE and coverage (only when SE is available)
has_se  <- !is.na(df$se)
mean_se <- if (any(has_se)) mean(df$se[has_se]) else NA_real_
se_ratio <- if (!is.na(mean_se) && emp_se > 0) mean_se / emp_se else NA_real_
has_ci  <- !is.na(df$ci_low) & !is.na(df$ci_high)
coverage <- if (any(has_ci)) {
mean(df$ci_low[has_ci] <= true & true <= df$ci_high[has_ci])
} else NA_real_
data.frame(
n_reps   = n_ok,
n_fail   = n_fail,
bias     = bias,
emp_se   = emp_se,
mean_se  = mean_se,
se_ratio = se_ratio,
rmse     = rmse,
coverage = coverage
)
}
metrics <- do.call(rbind, lapply(
split(sim_df, interaction(sim_df$method, sim_df$param, drop = TRUE)),
compute_metrics
))
# Parse the row names back into method and param
parts <- strsplit(rownames(metrics), "\\.")
metrics$method <- sapply(parts, `[`, 1)
metrics$param  <- sapply(parts, `[`, 2)
rownames(metrics) <- NULL
# Reorder columns
metrics <- metrics[, c("method", "param", "n_reps", "n_fail",
"bias", "emp_se", "mean_se", "se_ratio",
"rmse", "coverage")]
# Sort
metrics <- metrics[order(metrics$param, metrics$method), ]
# ============================================================================
# 6. Print results
# ============================================================================
cat(strrep("=", 80), "\n")
cat("SIMULATION RESULTS\n")
cat(sprintf("  Replications: %d | Subjects per rep: %d\n", N_SIM, N_SUBJ))
cat(sprintf("  True beta:  Z = %.1f,  X = %.1f\n", TRUE_BETA["Z"], TRUE_BETA["X"]))
cat(strrep("=", 80), "\n\n")
for (p in PARAM_NAMES) {
sub <- metrics[metrics$param == p, ]
cat(sprintf("--- beta_%s (true = %.1f) ---\n\n", p, TRUE_BETA[p]))
print_df <- data.frame(
Method   = sub$method,
Reps     = sub$n_reps,
Fail     = sub$n_fail,
Bias     = sprintf("%+.4f", sub$bias),
Emp.SE   = sprintf("%.4f", sub$emp_se),
Mean.SE  = ifelse(is.na(sub$mean_se), "---", sprintf("%.4f", sub$mean_se)),
SE.Ratio = ifelse(is.na(sub$se_ratio), "---", sprintf("%.3f", sub$se_ratio)),
RMSE     = sprintf("%.4f", sub$rmse),
Cov.95   = ifelse(is.na(sub$coverage), "---", sprintf("%.3f", sub$coverage))
)
print(print_df, row.names = FALSE, right = FALSE)
cat("\n")
}
cat("SE.Ratio = Mean.SE / Emp.SE (should be near 1.0 if SE is well-calibrated)\n")
cat("Cov.95   = empirical coverage of 95% CI (should be near 0.950)\n\n")
# ============================================================================
# 7. Save everything
# ============================================================================
dir.create(dirname(OUT_FILE), recursive = TRUE, showWarnings = FALSE)
saveRDS(
list(
sim_df      = sim_df,
metrics     = metrics,
settings    = list(
n_sim     = N_SIM,
n_subj    = N_SUBJ,
true_beta = TRUE_BETA,
true_gamma = TRUE_GAMMA,
true_alpha = TRUE_ALPHA
),
elapsed_min = elapsed
),
file = OUT_FILE
)
cat(sprintf("Results saved to %s\n", OUT_FILE))
load(sim_results.rds)
sim_results <- readRDS("/Users/yh785/Downloads/DSDE/Research/CIMEHR R Package/CIMEHR/simulations/sim_results.rds")
sim_results
devtools::document()
res = devtools::check()
## ---- simulations/simulation_study.R ------------------------------------------
## Monte Carlo simulation study (1,000 replications) to evaluate
## bias, empirical standard error (SE), coverage, and residual mean
## square error (RMSE) for Generalized Informative Visiting and observation processes
## in Electronic Health Records (GIVEHR) method.
##
## The design mirrors the data-generating process in sim_data_gen()
## with default parameters. Each replication:
##   1. Generates a fresh dataset (n = 2000)
##   2. Fits every method
##   3. Extracts outcome beta estimates (and SE / CI where available)
##
## Results are saved to an RDS file for downstream analysis.
##
## Usage:
##   Rscript simulations/simulation_study.R          # single-core
##   Rscript simulations/simulation_study.R --cores 8 # parallel
## ---------------------------------------------------------------------------
# ============================================================================
# 0. Setup
# ============================================================================
library(CIMEHR)
args <- commandArgs(trailingOnly = TRUE)
N_SIM    <- 1000
N_SUBJ   <- 2000
N_CORES  <- 1
OUT_FILE <- "simulations/sim_results.rds"
# Parse --cores flag
if ("--cores" %in% args) {
idx <- which(args == "--cores")
N_CORES <- as.integer(args[idx + 1])
}
# Parse --nsim flag
if ("--nsim" %in% args) {
idx <- which(args == "--nsim")
N_SIM <- as.integer(args[idx + 1])
}
# Parse --n flag
if ("--n" %in% args) {
idx <- which(args == "--n")
N_SUBJ <- as.integer(args[idx + 1])
}
# Parse --out flag
if ("--out" %in% args) {
idx <- which(args == "--out")
OUT_FILE <- args[idx + 1]
}
cat(sprintf("Simulation study: %d replications, n = %d, cores = %d\n",
N_SIM, N_SUBJ, N_CORES))
cat(sprintf("Output: %s\n\n", OUT_FILE))
# True parameter values (defaults from sim_data_gen)
TRUE_BETA  <- c(intercept = -2, Z = -0.5, X = 0.5)
TRUE_GAMMA <- c(intercept = -2.2, Z = 1, X = 1)
TRUE_ALPHA <- c(intercept = 1.5, Z = -0.5, X = -0.3)
# Parameters to track (outcome betas, excluding intercept)
PARAM_NAMES <- c("Z", "X")
# ============================================================================
# 1. Method definitions
# ============================================================================
# Each method function takes a data.frame and returns a named list:
#   $beta   - named numeric vector of outcome coefficient estimates
#   $se     - named numeric vector of SE (NULL if unavailable)
#   $ci_low - named numeric vector of CI lower bound (NULL if unavailable)
#   $ci_high- named numeric vector of CI upper bound (NULL if unavailable)
#   $extra  - optional named list of additional estimates (e.g., gamma)
methods <- list(
GIVEHR = function(dat) {
fit <- GIVEHR(data = dat)
beta <- fit$longitudinal_outcome$beta_Y
se   <- fit$longitudinal_outcome$se_beta_naive
z    <- qnorm(0.975)
list(
beta    = beta,
se      = se,
ci_low  = beta - z * se,
ci_high = beta + z * se,
extra   = list(gamma = fit$visiting_process$gamma_V,
sigma2_zeta = fit$visiting_process$sigma2_zeta)
)
}
)
METHOD_NAMES <- names(methods)
# ============================================================================
# 2. Single-replication worker
# ============================================================================
run_one_rep <- function(sim_id, phi) {
# Generate data
suppressMessages(
sim <- sim_data_gen(n = N_SUBJ, seed = sim_id, phi = phi)
)
dat   <- sim$long_data
dat$C <- sim$params$time.end
# Run all methods; catch failures per method
rep_results <- list()
for (m in METHOD_NAMES) {
rep_results[[m]] <- tryCatch(
methods[[m]](dat),
error = function(e) {
list(beta = NULL, se = NULL, ci_low = NULL, ci_high = NULL,
error = conditionMessage(e))
}
)
}
list(sim_id = sim_id, results = rep_results)
}
# ============================================================================
# 3. Run all replications
# ============================================================================
cat("Starting simulations ...\n")
t0 <- Sys.time()
# ---- Simulation 1: phi = 0.1 (OU serial correlation, default) ----
cat("\nRunning Simulation 1: phi = 0.1 (OU serial correlation) ...\n")
if (N_CORES > 1 && requireNamespace("parallel", quietly = TRUE)) {
cat(sprintf("  Using %d cores\n", N_CORES))
all_reps_phi01 <- parallel::mclapply(
seq_len(N_SIM), run_one_rep, phi = 0.1,
mc.cores = N_CORES, mc.set.seed = TRUE
)
} else {
all_reps_phi01 <- vector("list", N_SIM)
for (i in seq_len(N_SIM)) {
cat(sprintf("  Simulation %d / %d\r", i, N_SIM))
flush.console()
all_reps_phi01[[i]] <- run_one_rep(i, phi = 0.1)
}
cat(sprintf("  Simulation %d / %d -- done\n", N_SIM, N_SIM))
}
# ---- Simulation 2: phi = 0 (independent observation noise) ----
cat("\nRunning Simulation 2: phi = 0 (independent observation noise) ...\n")
if (N_CORES > 1 && requireNamespace("parallel", quietly = TRUE)) {
cat(sprintf("  Using %d cores\n", N_CORES))
all_reps_phi0 <- parallel::mclapply(
seq_len(N_SIM), run_one_rep, phi = 0,
mc.cores = N_CORES, mc.set.seed = TRUE
)
} else {
all_reps_phi0 <- vector("list", N_SIM)
for (i in seq_len(N_SIM)) {
cat(sprintf("  Simulation %d / %d\r", i, N_SIM))
flush.console()
all_reps_phi0[[i]] <- run_one_rep(i, phi = 0)
}
cat(sprintf("  Simulation %d / %d -- done\n", N_SIM, N_SIM))
}
elapsed <- as.numeric(difftime(Sys.time(), t0, units = "mins"))
cat(sprintf("\nBoth simulations done in %.1f minutes.\n\n", elapsed))
# ============================================================================
# 4. Assemble results into a tidy data.frame
# ============================================================================
assemble <- function(all_reps, phi_label) {
rows <- list()
for (rep in all_reps) {
for (m in METHOD_NAMES) {
res <- rep$results[[m]]
if (is.null(res$beta)) {
for (p in PARAM_NAMES) {
rows[[length(rows) + 1]] <- data.frame(
phi     = phi_label,
sim_id  = rep$sim_id,
method  = m,
param   = p,
est     = NA_real_,
se      = NA_real_,
ci_low  = NA_real_,
ci_high = NA_real_,
failed  = TRUE,
stringsAsFactors = FALSE
)
}
} else {
for (p in PARAM_NAMES) {
rows[[length(rows) + 1]] <- data.frame(
phi     = phi_label,
sim_id  = rep$sim_id,
method  = m,
param   = p,
est     = if (p %in% names(res$beta)) res$beta[p] else NA_real_,
se      = if (!is.null(res$se) && p %in% names(res$se)) res$se[p] else NA_real_,
ci_low  = if (!is.null(res$ci_low)  && p %in% names(res$ci_low))  res$ci_low[p]  else NA_real_,
ci_high = if (!is.null(res$ci_high) && p %in% names(res$ci_high)) res$ci_high[p] else NA_real_,
failed  = FALSE,
stringsAsFactors = FALSE
)
}
}
}
}
do.call(rbind, rows)
}
sim_df <- rbind(
assemble(all_reps_phi01, phi_label = "phi=0.1"),
assemble(all_reps_phi0,  phi_label = "phi=0")
)
rownames(sim_df) <- NULL
sim_df$true_value <- TRUE_BETA[sim_df$param]
# ============================================================================
# 5. Compute performance metrics
# ============================================================================
compute_metrics <- function(df) {
df     <- df[!df$failed & !is.na(df$est), ]
n_ok   <- nrow(df)
n_fail <- sum(df$failed, na.rm = TRUE)
if (n_ok == 0) {
return(data.frame(
n_reps = 0, n_fail = n_fail,
bias = NA, emp_se = NA, mean_se = NA,
se_ratio = NA, rmse = NA, coverage = NA
))
}
true     <- df$true_value[1]
bias     <- mean(df$est) - true
emp_se   <- sd(df$est)
rmse     <- sqrt(mean((df$est - true)^2))
has_se   <- !is.na(df$se)
mean_se  <- if (any(has_se)) mean(df$se[has_se]) else NA_real_
se_ratio <- if (!is.na(mean_se) && emp_se > 0) mean_se / emp_se else NA_real_
has_ci   <- !is.na(df$ci_low) & !is.na(df$ci_high)
coverage <- if (any(has_ci)) {
mean(df$ci_low[has_ci] <= true & true <= df$ci_high[has_ci])
} else NA_real_
data.frame(
n_reps = n_ok, n_fail = n_fail,
bias = bias, emp_se = emp_se, mean_se = mean_se,
se_ratio = se_ratio, rmse = rmse, coverage = coverage
)
}
metrics <- do.call(rbind, lapply(
split(sim_df, paste(sim_df$phi, sim_df$method, sim_df$param, sep = "||")),
compute_metrics
))
keys           <- strsplit(rownames(metrics), "\\|\\|")
metrics$phi    <- sapply(keys, `[`, 1)
metrics$method <- sapply(keys, `[`, 2)
metrics$param  <- sapply(keys, `[`, 3)
rownames(metrics) <- NULL
metrics <- metrics[, c("phi", "method", "param", "n_reps", "n_fail",
"bias", "emp_se", "mean_se", "se_ratio", "rmse", "coverage")]
metrics <- metrics[order(metrics$phi, metrics$param, metrics$method), ]
# ============================================================================
# 6. Print results
# ============================================================================
cat(strrep("=", 80), "\n")
cat("SIMULATION RESULTS\n")
cat(sprintf("  Replications: %d | Subjects per rep: %d\n", N_SIM, N_SUBJ))
cat(sprintf("  True beta:  Z = %.1f,  X = %.1f\n", TRUE_BETA["Z"], TRUE_BETA["X"]))
cat(strrep("=", 80), "\n\n")
for (phi_label in c("phi=0.1", "phi=0")) {
cat(sprintf("--- %s ---\n\n", phi_label))
sub_phi <- metrics[metrics$phi == phi_label, ]
for (p in PARAM_NAMES) {
sub <- sub_phi[sub_phi$param == p, ]
cat(sprintf("  beta_%s (true = %.1f)\n\n", p, TRUE_BETA[p]))
print_df <- data.frame(
Method   = sub$method,
Reps     = sub$n_reps,
Fail     = sub$n_fail,
Bias     = sprintf("%+.4f", sub$bias),
Emp.SE   = sprintf("%.4f",  sub$emp_se),
Mean.SE  = ifelse(is.na(sub$mean_se),  "---", sprintf("%.4f", sub$mean_se)),
SE.Ratio = ifelse(is.na(sub$se_ratio), "---", sprintf("%.3f", sub$se_ratio)),
RMSE     = sprintf("%.4f", sub$rmse),
Cov.95   = ifelse(is.na(sub$coverage), "---", sprintf("%.3f", sub$coverage))
)
print(print_df, row.names = FALSE, right = FALSE)
cat("\n")
}
}
cat("SE.Ratio = Mean.SE / Emp.SE (should be near 1.0 if SE is well-calibrated)\n")
cat("Cov.95   = empirical coverage of 95% CI (should be near 0.950)\n\n")
# ============================================================================
# 7. Save everything
# ============================================================================
dir.create(dirname(OUT_FILE), recursive = TRUE, showWarnings = FALSE)
saveRDS(
list(
sim_df      = sim_df,
metrics     = metrics,
settings    = list(
n_sim      = N_SIM,
n_subj     = N_SUBJ,
true_beta  = TRUE_BETA,
true_gamma = TRUE_GAMMA,
true_alpha = TRUE_ALPHA
),
elapsed_min = elapsed
),
file = OUT_FILE
)
cat(sprintf("Results saved to %s\n", OUT_FILE))
sim_results <- readRDS("/Users/yh785/Downloads/DSDE/Research/CIMEHR R Package/CIMEHR/simulations/sim_results.rds")
sim_results
devtools::document()
res = devtools::check()
res$errors
res$warnings
res$notes
devtools::document()
res = devtools::check()
res$errors
res$warnings
res$notes
devtools::build_manual()
devtools::build_manual()
sim_results <- readRDS("/Users/yh785/Downloads/DSDE/Research/CIMEHR R Package/CIMEHR/simulations/sim_results.rds")
sim_results
