# Load necessary libraries
library(readxl)
library(DiagrammeR)
library(DiagrammeRsvg)
library(rsvg)
library(ggpubr)
library(tidyverse)
panel_data <- tribble(
~Panel, ~Category, ~Group, ~Count,
# Algorithm Type
"Algorthim Type", "cGAN", "Algorithms and Metrics", 1,
"Algorthim Type", "GLM", "Algorithms and Metrics", 1,
"Algorthim Type", "RNN", "Algorithms and Metrics", 1,
"Algorthim Type", "ViT", "Algorithms and Metrics", 1,
"Algorthim Type", "Autoencoder", "Algorithms and Metrics", 2,
"Algorthim Type", "DT", "Algorithms and Metrics", 2,
"Algorthim Type", "Ensemble", "Algorithms and Metrics", 2,
"Algorthim Type", "GBM", "Algorithms and Metrics", 6,
"Algorthim Type", "LR", "Algorithms and Metrics", 7,
"Algorthim Type", "RF", "Algorithms and Metrics", 7,
"Algorthim Type", "SVM", "Algorithms and Metrics", 7,
"Algorthim Type", "CNN", "Algorithms and Metrics", 25,
# Dataset Source Population
"Source Population", "North America", "Region", 21,
"Source Population", "Europe", "Region", 3,
"Source Population", "Asia", "Region", 16,
# Training Dataset Size
"Training Size", "<100", "Data Sizes", 2,
"Training Size", "100-500", "Data Sizes", 16,
"Training Size", "500-1000", "Data Sizes", 9,
"Training Size", ">1000", "Data Sizes", 3,
"Training Size", "Not Reported ", "Data Sizes", 6,
# Internal Test Set Size
"Internal Test Size", "<100", "Data Sizes", 12,
"Internal Test Size", "100-500", "Data Sizes", 6,
"Internal Test Size", ">500", "Data Sizes", 4,
"Internal Test Size", "CV in Training Set", "Data Sizes", 8,
"Internal Test Size", "Not Reported", "Data Sizes", 6,
# External Test Set Size
"External Test Size", "<100", "Data Sizes", 6,
"External Test Size", "100-200", "Data Sizes", 7,
"External Test Size", "200-500", "Data Sizes", 3,
"External Test Size", "500-2000", "Data Sizes", 1,
"External Test Size", ">2000", "Data Sizes", 3,
#Test set categories
#"Validation Method", "Internal", "Usage", 35,
#"Validation Method", "External", "Usage", 35,
# Other Data Type/Input Data
#"Input Data", "Demographic", "Input Data", 35,
#"Input Data", "Clinical", "Input Data", 35,
# Lung Cancer Outcome
"Outcome Type", "Detection", "Outcome", 14,
"Outcome Type", "Risk prediction", "Outcome", 9,
"Outcome Type", "Prognosis", "Outcome", 18,
#Evaluation Metric
"Evaluation Metric", "FROC", "Algorithms and Metrics", 2,
"Evaluation Metric", "Confusion Matrix", "Algorithms and Metrics", 4,
"Evaluation Metric", "DCA", "Algorithms and Metrics", 4,
"Evaluation Metric", "NPV", "Algorithms and Metrics", 4,
"Evaluation Metric", "PPV", "Algorithms and Metrics", 4,
"Evaluation Metric", "C-Index", "Algorithms and Metrics", 5,
"Evaluation Metric", "Calibration Plot", "Algorithms and Metrics", 5,
"Evaluation Metric", "Precision", "Algorithms and Metrics", 7,
"Evaluation Metric", "F1 Score", "Algorithms and Metrics", 11,
"Evaluation Metric", "Specificity", "Algorithms and Metrics", 16,
"Evaluation Metric", "Accuracy","Algorithms and Metrics", 20,
"Evaluation Metric", "Sensitivity", "Algorithms and Metrics", 21,
"Evaluation Metric", "AUC", "Algorithms and Metrics", 29,
# Uncertainty Quantification
"Reported UQ", "None", "Algorithms and Metrics", 11,
"Reported UQ", "Evaluation Metrics", "Algorithms and Metrics", 20,
"Reported UQ", "Others", "Algorithms and Metrics", 5,
#Subgroup Evaluation
#"Subgroup Evaluation", "Subgroup Evaluated", "Evaluated", 35,
#"Data/Code Availability", "Data", "Data/Code Availability", 35,
#"Data/Code Availability", "Code", "Data/Code Availability", 35
)
panel_data <- panel_data %>%
add_row(Panel = "Data/Code Availability", Category = "Data", Group = "Yes", Count = 17) %>%
add_row(Panel = "Data/Code Availability", Category = "Data", Group = "No", Count = 19) %>%
add_row(Panel = "Data/Code Availability", Category = "Code", Group = "Yes", Count = 7) %>%
add_row(Panel = "Data/Code Availability", Category = "Code", Group = "No", Count = 29)
panel_data <- panel_data %>%
add_row(Panel = "Additional Input Data", Category = "Demographic", Group = "Yes", Count = 12) %>%
add_row(Panel = "Additional Input Data", Category = "Demographic", Group = "No", Count = 24) %>%
add_row(Panel = "Additional Input Data", Category = "Clinical", Group = "Yes", Count = 13) %>%
add_row(Panel = "Additional Input Data", Category = "Clinical", Group = "No", Count = 23)
panel_data <- panel_data %>%
add_row(Panel = "Validation Method", Category = "Internal", Group = "Yes", Count = 35) %>%
add_row(Panel = "Validation Method", Category = "Internal", Group = "No", Count = 1) %>%
add_row(Panel = "Validation Method", Category = "External", Group = "Yes", Count = 14) %>%
add_row(Panel = "Validation Method", Category = "External", Group = "No", Count = 22)
#"Subgroup Evaluation", "Subgroup Evaluated", "Evaluated", 35,
panel_data <- panel_data %>%
add_row(Panel = "Subgroup Evaluation", Category = "Subgroup", Group = "Yes", Count = 10) %>%
add_row(Panel = "Subgroup Evaluation", Category = "Subgroup", Group = "No", Count = 26)
panel_data <- panel_data %>%
mutate(BarWidth = case_when(
Panel %in% c("Subgroup Evaluation", "Validation Method",
"Outcome Type", "Source Population", "Reported UQ") ~ 0.5,
TRUE ~ 0.8  # default width
))
panel_data <- panel_data %>%
mutate(Category = as.character(Category)) %>%  # <-- force drop old factor structure
mutate(Category = case_when(
Panel == "Algorithm Type" ~ factor(Category, levels = c("cGAN","GLM","RNN","ViT",
"Autoencoder","DT","Ensemble","GBM",
"LR", "RF", "SVM", "CNN")),
Panel == "Source Population" ~ factor(Category, levels = c("Europe", "Asia", "North America")),
Panel == "Additional Input Data" ~ factor(Category, levels = c("Demographic", "Clinical")),
Panel == "Training Size" ~ factor(Category, levels = c("<100", "100-500", "500-1000", ">1000", "Not Reported ")),
Panel == "Internal Test Size" ~ factor(Category, levels = c("<100", "100-500", ">500", "CV in Training Set", "Not Reported")),
Panel == "External Test Size" ~ factor(Category, levels = c("<100", "100-200", "200-500", "500-2000", ">2000")),
Panel == "Validation Method" ~ factor(Category, levels = c("Internal", "External")),
Panel == "Outcome Type" ~ factor(Category, levels = c("Risk prediction", "Detection", "Prognosis")),
Panel == "Evaluation Metric" ~ factor(Category, levels = c("FROC", "Confusion Matrix", "DCA",
"NPV", "PPV", "C-Index", "Calibration Plot",
"Precision", "F1 Score", "Specificity",
"Accuracy", "Sensitivity", "AUC")),
Panel == "Reported UQ" ~ factor(Category, levels = c("Others","None", "Evaluation Metrics")),
Panel == "Data/Code Availability" ~ factor(Category, levels = c("Data", "Code")),
TRUE ~ factor(Category)
))
#panel_data <- panel_data %>%
#  mutate(Panel = factor(Panel, levels = panel_order))
# Create a legend-only variable (used just for scale)
panel_data <- panel_data %>%
mutate(
display_group = ifelse(Group %in% c("Yes", "No"), Group, NA)
)
# Color palette
fill_colors <- c(
"Region" = "orange2", "Data Sizes" = "palegreen2",
"Outcome" = "#7570B3",
"Algorithms and Metrics" = "darkseagreen4",
"Yes" = "salmon", "No" = "steelblue"
)
panel_order <- c(
"Source Population", "Training Size", "Internal Test Size", "External Test Size",
"Outcome Type", "Algorthim Type", "Evaluation Metric", "Reported UQ",
"Additional Input Data", "Data/Code Availability", "Subgroup Evaluation", "Validation Method"
)
panel_data <- panel_data %>%
mutate(Panel = factor(Panel, levels = panel_order))
panel_data <- panel_data %>%
mutate(
hjust_custom = case_when(
Panel == "Additional Input Data" & Count == 24 ~ 2.10,
Panel == "Additional Input Data" & Count ==12 ~ -1.10,
Panel == "Additional Input Data" & Count ==23 ~ 2.10,
Panel == "Additional Input Data" & Count ==13 ~ -1.10,
Panel == "Data/Code Availability" & Count ==19 ~ 2.10,
Panel == "Data/Code Availability" & Count ==17 ~ -1.1,
Panel == "Data/Code Availability" & Count ==29 ~ 2.10,
Panel == "Data/Code Availability" & Count ==7 ~ -2.80,
Panel == "Subgroup Evaluation" & Count == 26 ~ 3.0,
Panel == "Subgroup Evaluation" & Count == 10 ~ -1.50,
Panel == "Validation Method" & Count == 1 ~ 2.80,
Panel == "Validation Method" & Count == 35 ~ -0.80,
Panel == "Validation Method" & Count == 22 ~ 1.80,
Panel == "Validation Method" & Count == 14 ~ -0.80,
TRUE ~ 0.5
),
vjust_custom = case_when(
TRUE ~ -0.2  # default center
)
)
ggplot(panel_data, aes(x = Category, y = Count, width = BarWidth)) +
geom_col(aes(fill = Group), width = 0.6, data = filter(panel_data, Panel == "Data/Code Availability"), position = "dodge") +
geom_col(aes(fill = Group), width = 0.6, data = filter(panel_data, Panel == "Additional Input Data"),  position = "dodge") +
geom_col(aes(fill = Group), width = 0.6, data = filter(panel_data, Panel == "Validation Method"),  position = "dodge") +
geom_col(aes(fill = Group), width = 0.6, data = filter(panel_data, Panel == "Subgroup Evaluation"), position = "dodge") +
geom_col(aes(fill = Group), data = filter(
panel_data,
!Panel %in% c("Data/Code Availability", "Additional Input Data", "Validation Method", "Subgroup Evaluation")
), position = "dodge") +
facet_wrap(~ Panel, ncol = 4, scales = "free_x") +
geom_text(
aes(label = Count, vjust = vjust_custom, hjust = hjust_custom),
position = position_dodge(width = 0.9),
size = 2.8,
family = "Times"
)+
# Control color mapping but generate legend from display_group
scale_fill_manual(
values = fill_colors,
breaks = c("No", "Yes"),  # only show these in legend
na.translate = FALSE
) +
labs(
x = NULL, y = "Study Count", fill = " "
) +
ylim(0, max(panel_data$Count) + 3) +
theme_minimal(base_family = "Times") +
theme(
panel.border = element_rect(color = "grey60", fill = NA, linewidth = 0.5),
strip.background = element_rect(fill = "grey90"),
strip.text = element_text(face = "bold", size = 11),
axis.text.x = element_text(angle = 29, hjust = 1, size = 8, color = "black"),
legend.position = "right",  # turn off default legend position
legend.position.inside = c(1.05, 0.2),  # normalized figure coordinates
legend.justification = c(0, 0),
legend.direction = "vertical",
legend.box.margin = margin(0, 0, 0, 0)
)
