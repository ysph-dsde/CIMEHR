"Precision", "F1 Score", "Specificity",
"Accuracy", "Sensitivity", "AUC")),
Panel == "Source Population" ~ factor(Category, levels = c("Europe", "Asia", "North America")),
Panel == "Algorithm Type" ~ factor(Category, levels = c("GBM",
"LR", "RF", "SVM", "CNN")),
Panel == "Training Size" ~ factor(Category, levels = c("<100", "100-500", "500-1000", ">1000", "Not Reported ")),
Panel == "Internal Test Size" ~ factor(Category, levels = c("<100", "100-500", ">500", "CV in Training Set", "Not Reported")),
Panel == "External Test Size" ~ factor(Category, levels = c("<100", "100-200", "200-500", "500-2000", ">2000")),
Panel == "Reported UQ" ~ factor(Category, levels = c("Others","None", "Evaluation Metrics")),
TRUE ~ factor(Category)
))
#new_row = c("Internal Test Set Usage", "Yes", NA, "Risk prediction", 7)
#panel_data = rbind(panel_data,new_row)
panel_order <- c(
"Source Population",
"Training Size",
"Internal Test Size",
"External Test Size",
"Algorithm Type",
"Evaluation Metric",
"Reported UQ",
"Subgroup Evaluation",
"Demographic Input Data",
"Clinical Input Data",
"Code Availability",
"Data Availability",
"Internal Test Set Usage",
"External Test Set Usage"
)
panel_data_clean <- panel_data%>%
mutate(Panel = factor(Panel, levels = panel_order))
# clean Group
panel_data_clean <- panel_data_clean %>%
mutate(Group = ifelse(is.na(Group), "Overall", Group))
panel_data_clean <- panel_data_clean %>%
mutate(
hjust_custom = case_when(
TRUE ~ 0.5
),
vjust_custom = case_when(
TRUE ~ -0.5  # default center
)
)
panel_data_clean$Count = as.numeric(panel_data_clean$Count)
ggplot(panel_data_clean, aes(
x = Category,
y = Count,
fill = Outcome
)) +
geom_bar(
stat = "identity",
position = position_stack(),
width = 0.7,
aes(group = interaction(Group, Outcome))
)  +
# geom_text(
#   aes(label = Count, vjust = vjust_custom, hjust = hjust_custom),
#   position = position_dodge(width = 0.9),
#   size = 2.8,
#   family = "Times"
# )+
facet_wrap(~ Panel,ncol = 4, scales = "free_x") +
scale_fill_manual(
values = c(
"Risk prediction" = "gold1",
"Detection" = "darkorchid1",
"Prognosis" = "steelblue1"
)
) +
ylim(0,  40) +
theme_minimal(base_family = "Times") +
theme(
panel.border = element_rect(color = "grey60", fill = NA, linewidth = 0.5),
strip.background = element_rect(fill = "grey90"),
strip.text = element_text(face = "bold", size = 10),
axis.text.x = element_text(angle = 29, hjust = 1,size = 8, color = "black"),
legend.position = "right"
) +
labs(
x = NULL,
y = "Study Count",
fill = "Outcome"
)
