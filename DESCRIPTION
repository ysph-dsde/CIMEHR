Package: CIMEHR
Type: Package
Title: Longitudinal EHR Analysis with Informative Visits and Recording
Version: 0.2.0
Authors@R: c(
    person(given = "Cheng-Han", family = "Yang",
           email = "chenghanyang728@gmail.com",
           role = c("aut","cre"),
           comment = c(ORCID = "0000-0002-4161-3140")),
    person(given = "Yiren", family = "Hou",
